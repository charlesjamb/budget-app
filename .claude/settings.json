{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run lint 2>&1 && npm run test 2>&1",
            "timeout": 120,
            "statusMessage": "Running linter and tests..."
          }
        ]
      }
    ]
  }
}
