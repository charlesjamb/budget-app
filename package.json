{
  "name": "budget-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint packages/*/src/",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run --workspace=packages/backend test",
    "test:frontend": "npm run --workspace=packages/frontend test",
    "dev:backend": "npm run --workspace=packages/backend dev",
    "dev:frontend": "npm run --workspace=packages/frontend dev",
    "dev": "npm run --workspace=packages/shared build && concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run --workspace=packages/shared build && npm run --workspace=packages/backend build && npm run --workspace=packages/frontend build",
    "seed": "npm run --workspace=packages/backend seed",
    "prepare": ""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0"
  }
}
