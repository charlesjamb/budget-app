{
  "name": "budget-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "lint": "eslint packages/*/src/",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "test": "pnpm run test:backend && pnpm run test:frontend",
    "test:backend": "pnpm --filter @budget-app/backend test",
    "test:frontend": "pnpm --filter @budget-app/frontend test",
    "dev:backend": "pnpm --filter @budget-app/backend dev",
    "dev:frontend": "pnpm --filter @budget-app/frontend dev",
    "dev": "pnpm --filter @budget-app/shared build && concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "build": "pnpm --filter @budget-app/shared build && pnpm --filter @budget-app/backend build && pnpm --filter @budget-app/frontend build",
    "seed": "pnpm --filter @budget-app/backend seed",
    "prepare": ""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.22.0"
  },
  "volta": {
    "node": "26.12.0",
    "pnpm": "12.14.0"
  }
}
